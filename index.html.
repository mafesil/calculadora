<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Calculadora de campo</title>
<meta name="theme-color" content="#861518">
<meta name="description" content="Calculadora de campo: vazão de bombas e rotação de motores com inversor de frequência.">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" href="icons/favicon.svg" type="image/svg+xml">
<link rel="icon" href="icons/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="icons/apple-touch-icon.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Calc. Campo">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<style>
@font-face{font-family:"Montserrat";font-style:normal;font-weight:400;font-display:swap;src:url("fonts/montserrat-latin-400-normal.woff2") format("woff2")}
@font-face{font-family:"Montserrat";font-style:normal;font-weight:500;font-display:swap;src:url("fonts/montserrat-latin-500-normal.woff2") format("woff2")}
@font-face{font-family:"Montserrat";font-style:normal;font-weight:600;font-display:swap;src:url("fonts/montserrat-latin-600-normal.woff2") format("woff2")}
@font-face{font-family:"Montserrat";font-style:normal;font-weight:700;font-display:swap;src:url("fonts/montserrat-latin-700-normal.woff2") format("woff2")}
@font-face{font-family:"Montserrat";font-style:normal;font-weight:800;font-display:swap;src:url("fonts/montserrat-latin-800-normal.woff2") format("woff2")}
</style>
<style>
:root{
  --vinho:#861518; --vinho-suave:#f6e9e9;
  --cinza:#4E5255; --cinza-2:#76787A; --linha:#D5D5D5;
  --fundo:#f3f3f3; --superficie:#ffffff; --texto:#2b2d2f; --texto-2:#5f6265;
  --campo:#fafafa; --aviso-bg:#fff6dc; --aviso-tx:#6b5200;
  color-scheme: light;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --vinho:#c8494c; --vinho-suave:#3a2223;
    --cinza:#c9cbcd; --cinza-2:#9a9c9e; --linha:#3b3e41;
    --fundo:#1b1c1e; --superficie:#242629; --texto:#ececec; --texto-2:#a7a9ab;
    --campo:#1e2022; --aviso-bg:#3a3220; --aviso-tx:#f0d68a;
    color-scheme: dark;
  }
}
:root[data-theme="dark"]{
  --vinho:#c8494c; --vinho-suave:#3a2223;
  --cinza:#c9cbcd; --cinza-2:#9a9c9e; --linha:#3b3e41;
  --fundo:#1b1c1e; --superficie:#242629; --texto:#ececec; --texto-2:#a7a9ab;
  --campo:#1e2022; --aviso-bg:#3a3220; --aviso-tx:#f0d68a;
  color-scheme: dark;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{
  margin:0; background:var(--fundo); color:var(--texto);
  font-family:"Montserrat",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
  font-size:16px; line-height:1.45;
}
.app{max-width:520px; margin:0 auto; padding:20px 16px 40px}

header{display:flex; align-items:center; gap:12px; margin-bottom:18px}
.engrenagem{width:34px; height:34px; flex:none; color:var(--vinho)}
header h1{font-size:1.15rem; font-weight:700; margin:0; color:var(--cinza); letter-spacing:.01em}
header p{margin:2px 0 0; font-size:.8rem; color:var(--texto-2)}

.abas{display:grid; grid-template-columns:1fr 1fr; gap:6px; background:var(--superficie);
  border:1px solid var(--linha); border-radius:12px; padding:5px; margin-bottom:16px}
.abas button{font:inherit; font-weight:600; font-size:.92rem; border:0; border-radius:8px;
  padding:12px 8px; background:transparent; color:var(--texto-2); cursor:pointer}
.abas button[aria-selected="true"]{background:var(--vinho); color:#fff}
.abas button:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible{
  outline:3px solid var(--vinho); outline-offset:2px}

.painel{background:var(--superficie); border:1px solid var(--linha); border-radius:14px; overflow:hidden}
.painel[hidden]{display:none}

.resultado{background:var(--vinho); color:#fff; padding:20px 18px 18px}
.resultado .rotulo{font-size:.82rem; font-weight:500; opacity:.85}
.resultado .valor{font-size:2.6rem; font-weight:800; line-height:1.1; margin-top:4px;
  font-variant-numeric:tabular-nums; word-break:break-word}
.resultado .valor small{font-size:1rem; font-weight:600; margin-left:6px; opacity:.9}
.resultado .extra{margin-top:10px; font-size:.86rem; display:flex; flex-wrap:wrap; gap:6px 16px; opacity:.92}
.resultado .vazio{font-size:1rem; font-weight:500; opacity:.9; margin-top:6px}

.corpo{padding:18px}
.grupo{margin-bottom:16px}
.grupo:last-child{margin-bottom:0}
label{display:block; font-size:.85rem; font-weight:600; color:var(--cinza); margin-bottom:6px}
.dica{font-weight:400; color:var(--texto-2)}
.linha-campo{display:flex; gap:8px}
input, select{
  font:inherit; font-size:1.15rem; font-weight:600; width:100%; min-width:0;
  padding:12px 12px; border:1.5px solid var(--linha); border-radius:10px;
  background:var(--campo); color:var(--texto); font-variant-numeric:tabular-nums}
select{width:auto; flex:none; font-size:.95rem; padding-right:8px}
input::placeholder{color:var(--texto-2); font-weight:400}

.dupla{display:grid; grid-template-columns:1fr 1fr; gap:10px}

.alternar{display:grid; grid-template-columns:1fr 1fr; border:1.5px solid var(--linha); border-radius:10px; overflow:hidden}
.alternar button{font:inherit; font-weight:600; font-size:.92rem; border:0; padding:11px 6px;
  background:var(--campo); color:var(--texto-2); cursor:pointer}
.alternar button[aria-pressed="true"]{background:var(--cinza); color:var(--superficie)}

details{border-top:1px solid var(--linha); margin-top:18px; padding-top:14px}
summary{cursor:pointer; font-weight:600; font-size:.9rem; color:var(--cinza); list-style:none; display:flex; justify-content:space-between; align-items:center}
summary::-webkit-details-marker{display:none}
summary::after{content:"+"; font-size:1.3rem; font-weight:500; color:var(--vinho)}
details[open] summary::after{content:"–"}
details .conteudo{margin-top:12px}

.aviso{margin-top:14px; background:var(--aviso-bg); color:var(--aviso-tx); border-radius:10px;
  padding:10px 12px; font-size:.84rem}
.aviso[hidden]{display:none}

.nota{margin:14px 2px 0; padding-left:10px; border-left:3px solid var(--vinho);
  font-size:.8rem; color:var(--texto-2)}

.limpar{display:block; margin:18px auto 0; font:inherit; font-size:.85rem; font-weight:600;
  background:none; border:0; color:var(--texto-2); text-decoration:underline; cursor:pointer; padding:8px}
/* ===================== CAPA ===================== */
:root{--faixa:#dcdcdc}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){--faixa:#2e3134} }
:root[data-theme="dark"]{--faixa:#2e3134}
html,body{height:100%}
.app[hidden],.capa[hidden]{display:none}
.capa{position:relative; min-height:100%; display:flex; flex-direction:column; overflow:hidden; max-width:520px; margin:0 auto}
.capa-faixa{position:relative; height:64px; background:var(--faixa); clip-path:polygon(0 0,100% 0,100% 100%,72px 100%); z-index:1}
.capa-faixa svg{position:absolute; right:18px; top:15px; width:34px; height:34px; color:var(--cinza-2); opacity:.7}
.capa-marca{position:absolute; right:-110px; top:150px; width:340px; height:340px; color:var(--faixa); opacity:.6; z-index:0; pointer-events:none}
.capa-topo{position:relative; z-index:1; padding:40px 24px 30px}
.capa-topo .icone{width:58px; height:58px; color:var(--vinho); display:block; margin-bottom:18px}
.capa-topo h1{margin:0; font-size:2.25rem; line-height:1.08; font-weight:800; color:var(--cinza); letter-spacing:-.01em}
.capa-topo p{margin:14px 0 0; max-width:30ch; font-size:.98rem; color:var(--texto-2)}
.capa-fio{width:56px; height:4px; background:var(--vinho); border-radius:2px; margin-top:22px}
.capa-opcoes{position:relative; z-index:1; display:grid; gap:12px; padding:0 20px}
.opcao{display:grid; grid-template-columns:46px 1fr 20px; align-items:center; gap:14px; width:100%; text-align:left; font:inherit; color:var(--texto);
  background:var(--superficie); border:1px solid var(--linha); border-left:5px solid var(--vinho); border-radius:12px; padding:18px 14px 18px 14px; cursor:pointer}
.opcao:active{transform:scale(.99)}
.opcao .ic{width:46px; height:46px; border-radius:50%; background:var(--vinho-suave); color:var(--vinho); display:grid; place-items:center}
.opcao .ic svg{width:24px; height:24px}
.opcao strong{display:block; font-size:1.05rem; font-weight:700; color:var(--cinza)}
.opcao span.desc{display:block; font-size:.84rem; color:var(--texto-2); margin-top:2px}
.opcao .seta{width:20px; height:20px; color:var(--cinza-2)}
.capa-rodape{position:relative; z-index:1; margin-top:auto; padding:36px 24px 26px; text-align:center; font-size:.78rem; color:var(--texto-2)}
.capa-rodape b{color:var(--cinza); font-weight:700}
header .inicio{margin-left:auto; font:inherit; font-size:.82rem; font-weight:600; color:var(--vinho); background:var(--superficie);
  border:1px solid var(--linha); border-radius:8px; padding:8px 12px; cursor:pointer}
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><symbol id="eng" viewBox="0 0 24 24"><path fill="currentColor" d="M13.6 2l.5 2.4c.6.2 1.2.4 1.7.7l2.1-1.3 2.3 2.3-1.3 2.1c.3.5.5 1.1.7 1.7l2.4.5v3.2l-2.4.5c-.2.6-.4 1.2-.7 1.7l1.3 2.1-2.3 2.3-2.1-1.3c-.5.3-1.1.5-1.7.7l-.5 2.4h-3.2l-.5-2.4c-.6-.2-1.2-.4-1.7-.7l-2.1 1.3-2.3-2.3 1.3-2.1c-.3-.5-.5-1.1-.7-1.7L2 13.6v-3.2l2.4-.5c.2-.6.4-1.2.7-1.7L3.8 6.1l2.3-2.3 2.1 1.3c.5-.3 1.1-.5 1.7-.7L10.4 2h3.2zM12 8a4 4 0 100 8 4 4 0 000-8z"/></symbol></svg>

<section class="capa" id="capa">
  <div class="capa-faixa"><svg aria-hidden="true"><use href="#eng"/></svg></div>
  <svg class="capa-marca" aria-hidden="true"><use href="#eng"/></svg>
  <div class="capa-topo">
    <svg class="icone" aria-hidden="true"><use href="#eng"/></svg>
    <h1>Calculadora<br>de campo</h1>
    <p>Vazão de bombas e rotação de motores acionados por inversor de frequência.</p>
    <div class="capa-fio"></div>
  </div>
  <div class="capa-opcoes">
    <button class="opcao" type="button" data-abrir="vazao">
      <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3s6 6.5 6 11a6 6 0 01-12 0c0-4.5 6-11 6-11z"/></svg></span>
      <span><strong>Vazão da bomba</strong><span class="desc">Vazão real a partir da capacidade e do Hz aplicado</span></span>
      <svg class="seta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
    </button>
    <button class="opcao" type="button" data-abrir="rotacao">
      <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 11-2.3-5.6"/><path d="M20 4v4h-4"/></svg></span>
      <span><strong>Rotação × Hz</strong><span class="desc">rpm do motor pelo Hz e Hz pela rpm</span></span>
      <svg class="seta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
    </button>
  </div>
  <div class="capa-rodape"><b>Gratt Service</b><br>Ferramenta de apoio em campo</div>
</section>

<div class="app" id="app" hidden>

  <header>
    <svg class="engrenagem" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.6 2l.5 2.4c.6.2 1.2.4 1.7.7l2.1-1.3 2.3 2.3-1.3 2.1c.3.5.5 1.1.7 1.7l2.4.5v3.2l-2.4.5c-.2.6-.4 1.2-.7 1.7l1.3 2.1-2.3 2.3-2.1-1.3c-.5.3-1.1.5-1.7.7l-.5 2.4h-3.2l-.5-2.4c-.6-.2-1.2-.4-1.7-.7l-2.1 1.3-2.3-2.3 1.3-2.1c-.3-.5-.5-1.1-.7-1.7L2 13.6v-3.2l2.4-.5c.2-.6.4-1.2.7-1.7L3.8 6.1l2.3-2.3 2.1 1.3c.5-.3 1.1-.5 1.7-.7L10.4 2h3.2zM12 8a4 4 0 100 8 4 4 0 000-8z"/></svg>
    <div>
      <h1>Calculadora de campo</h1>
      <p>Bombas e motores com inversor de frequência</p>
    </div>
    <button class="inicio" type="button" id="voltar">Início</button>
  </header>

  <div class="abas" role="tablist">
    <button role="tab" id="aba-vazao" aria-controls="p-vazao" aria-selected="true">Vazão da bomba</button>
    <button role="tab" id="aba-rotacao" aria-controls="p-rotacao" aria-selected="false">Rotação × Hz</button>
  </div>

  <!-- ===================== VAZÃO ===================== -->
  <section class="painel" id="p-vazao" role="tabpanel" aria-labelledby="aba-vazao">
    <div class="resultado" aria-live="polite">
      <div class="rotulo">Vazão na frequência aplicada</div>
      <div id="vz-saida"></div>
    </div>
    <div class="corpo">
      <div class="grupo">
        <label for="vz-cap">Capacidade da bomba <span class="dica">(na frequência nominal)</span></label>
        <div class="linha-campo">
          <input id="vz-cap" type="text" inputmode="decimal" placeholder="Ex.: 15" autocomplete="off">
          <select id="vz-uni" aria-label="Unidade da capacidade">
            <option value="m3h">m³/h</option>
            <option value="lh">L/h</option>
            <option value="lmin">L/min</option>
          </select>
        </div>
      </div>
      <div class="dupla">
        <div class="grupo">
          <label for="vz-fn">Freq. nominal (Hz)</label>
          <input id="vz-fn" type="text" inputmode="decimal" value="60" autocomplete="off">
        </div>
        <div class="grupo">
          <label for="vz-fa">Freq. aplicada (Hz)</label>
          <input id="vz-fa" type="text" inputmode="decimal" placeholder="Ex.: 45" autocomplete="off">
        </div>
      </div>
      <div class="aviso" id="vz-aviso" hidden></div>
      <p class="nota">Vazão proporcional à frequência: Q = Q<sub>nominal</sub> × Hz<sub>aplicada</sub> ÷ Hz<sub>nominal</sub>. Em bombas helicoidais e de deslocamento positivo o resultado é direto. Em bombas centrífugas é uma estimativa, porque a vazão real também depende da altura manométrica da linha.</p>
    </div>
  </section>

  <!-- ===================== ROTAÇÃO ===================== -->
  <section class="painel" id="p-rotacao" role="tabpanel" aria-labelledby="aba-rotacao" hidden>
    <div class="resultado" aria-live="polite">
      <div class="rotulo" id="rt-rotulo">Rotação</div>
      <div id="rt-saida"></div>
    </div>
    <div class="corpo">
      <div class="grupo">
        <label id="rt-modo-rot">O que você quer calcular?</label>
        <div class="alternar" role="group" aria-labelledby="rt-modo-rot">
          <button type="button" id="rt-m-rpm" aria-pressed="true">Hz → rpm</button>
          <button type="button" id="rt-m-hz" aria-pressed="false">rpm → Hz</button>
        </div>
      </div>

      <div class="dupla">
        <div class="grupo">
          <label for="rt-rpmn">Rotação de placa (rpm)</label>
          <input id="rt-rpmn" type="text" inputmode="decimal" placeholder="Ex.: 1770" autocomplete="off">
        </div>
        <div class="grupo">
          <label for="rt-fn">Freq. nominal (Hz)</label>
          <input id="rt-fn" type="text" inputmode="decimal" value="60" autocomplete="off">
        </div>
      </div>

      <div class="grupo" id="rt-g-hz">
        <label for="rt-hz">Frequência aplicada (Hz)</label>
        <input id="rt-hz" type="text" inputmode="decimal" placeholder="Ex.: 50" autocomplete="off">
      </div>

      <div class="grupo" id="rt-g-rpm" hidden>
        <label for="rt-rpm">Rotação desejada do motor (rpm)</label>
        <input id="rt-rpm" type="text" inputmode="decimal" placeholder="Ex.: 1500" autocomplete="off">
      </div>

      <div class="aviso" id="rt-aviso" hidden></div>
      <p class="nota">Rotação proporcional à frequência, a partir da rotação de placa (já com o escorregamento do motor): rpm = rpm<sub>placa</sub> × Hz ÷ Hz<sub>nominal</sub>.</p>
    </div>
  </section>

  <button class="limpar" type="button" id="limpar">Limpar campos</button>
</div>

<script>
(function(){
  const $ = id => document.getElementById(id);
  const num = v => { if(v==null) return NaN; const s=String(v).trim().replace(/\s/g,'').replace(',','.'); return s===''?NaN:Number(s); };
  const fmt = (v, casas) => v.toLocaleString('pt-BR',{minimumFractionDigits:0, maximumFractionDigits:casas});
  const ok = v => isFinite(v) && v > 0;

  // ---------- Armazenamento local (conveniência) ----------
  const CHAVE='calc-campo-v1';
  const campos=['vz-cap','vz-uni','vz-fn','vz-fa','rt-rpmn','rt-fn','rt-hz','rt-rpm'];
  let estado={aba:'vazao', modo:'rpm'};
  function salvar(){
    try{
      const d={aba:estado.aba, modo:estado.modo};
      campos.forEach(c=>d[c]=$(c).value);
      localStorage.setItem(CHAVE, JSON.stringify(d));
    }catch(e){}
  }
  function carregar(){
    try{
      const d=JSON.parse(localStorage.getItem(CHAVE)||'null');
      if(!d) return;
      campos.forEach(c=>{ if(d[c]!=null) $(c).value=d[c]; });
      if(d.aba) estado.aba=d.aba;
      if(d.modo) estado.modo=d.modo;
    }catch(e){}
  }

  // ---------- Abas ----------
  function mostrarAba(a){
    estado.aba=a;
    $('aba-vazao').setAttribute('aria-selected', a==='vazao');
    $('aba-rotacao').setAttribute('aria-selected', a==='rotacao');
    $('p-vazao').hidden = a!=='vazao';
    $('p-rotacao').hidden = a!=='rotacao';
    salvar();
  }
  $('aba-vazao').onclick=()=>mostrarAba('vazao');
  $('aba-rotacao').onclick=()=>mostrarAba('rotacao');

  // ---------- Vazão ----------
  const paraM3h={m3h:1, lh:0.001, lmin:0.06};
  function calcVazao(){
    const cap=num($('vz-cap').value), uni=$('vz-uni').value;
    const fn=num($('vz-fn').value), fa=num($('vz-fa').value);
    const saida=$('vz-saida'), aviso=$('vz-aviso');
    aviso.hidden=true;
    if(!ok(cap)||!ok(fn)||!(isFinite(fa)&&fa>=0)){
      saida.innerHTML='<div class="vazio">Informe a capacidade e as frequências.</div>';
      salvar(); return;
    }
    const q=cap*fa/fn;
    const m3h=q*paraM3h[uni];
    const rotUni={m3h:'m³/h',lh:'L/h',lmin:'L/min'}[uni];
    const pct=fa/fn*100;
    const outras=[];
    if(uni!=='m3h') outras.push(fmt(m3h,2)+' m³/h');
    if(uni!=='lmin') outras.push(fmt(m3h*1000/60,1)+' L/min');
    if(uni!=='lh') outras.push(fmt(m3h*1000,0)+' L/h');
    saida.innerHTML='<div class="valor">'+fmt(q, q<10?2:1)+'<small>'+rotUni+'</small></div>'+
      '<div class="extra"><span>'+fmt(pct,1)+'% da capacidade</span>'+outras.map(o=>'<span>'+o+'</span>').join('')+'</div>';
    if(fa>fn){ aviso.textContent='Frequência acima da nominal. Confira se a bomba e o motor suportam essa condição.'; aviso.hidden=false; }
    salvar();
  }

  // ---------- Rotação ----------
  function modoRot(m){
    estado.modo=m;
    $('rt-m-rpm').setAttribute('aria-pressed', m==='rpm');
    $('rt-m-hz').setAttribute('aria-pressed', m==='hz');
    $('rt-g-hz').hidden = m!=='rpm';
    $('rt-g-rpm').hidden = m!=='hz';
    calcRot();
  }
  $('rt-m-rpm').onclick=()=>modoRot('rpm');
  $('rt-m-hz').onclick=()=>modoRot('hz');

  function calcRot(){
    const rpmn=num($('rt-rpmn').value), fn=num($('rt-fn').value);
    const saida=$('rt-saida'), aviso=$('rt-aviso'), rot=$('rt-rotulo');
    aviso.hidden=true;

    if(!ok(rpmn)||!ok(fn)){
      rot.textContent = estado.modo==='rpm' ? 'Rotação' : 'Frequência necessária';
      saida.innerHTML='<div class="vazio">Informe a rotação de placa e a frequência nominal do motor.</div>';
      salvar(); return;
    }
    let hzFinal;
    if(estado.modo==='rpm'){
      const hz=num($('rt-hz').value);
      if(!(isFinite(hz)&&hz>=0)){
        rot.textContent='Rotação';
        saida.innerHTML='<div class="vazio">Informe a frequência aplicada.</div>'; salvar(); return;
      }
      hzFinal=hz;
      const rm=rpmn*hz/fn;
      rot.textContent='Rotação do motor';
      saida.innerHTML='<div class="valor">'+fmt(rm,0)+'<small>rpm</small></div>'+
        '<div class="extra"><span>'+fmt(hz/fn*100,1)+'% da rotação de placa</span></div>';
    }else{
      const alvo=num($('rt-rpm').value);
      rot.textContent='Frequência necessária';
      if(!ok(alvo)){ saida.innerHTML='<div class="vazio">Informe a rotação desejada.</div>'; salvar(); return; }
      const hz = alvo/rpmn*fn;
      hzFinal=hz;
      saida.innerHTML='<div class="valor">'+fmt(hz,1)+'<small>Hz</small></div>'+
        '<div class="extra"><span>'+fmt(hz/fn*100,1)+'% da frequência nominal</span></div>';
    }
    if(hzFinal>fn){ aviso.textContent='Acima da frequência nominal o motor perde torque (enfraquecimento de campo). Confira o limite de rotação do equipamento.'; aviso.hidden=false; }
    salvar();
  }

  // ---------- Eventos ----------
  ['vz-cap','vz-fn','vz-fa'].forEach(id=>$(id).addEventListener('input',calcVazao));
  $('vz-uni').addEventListener('change',calcVazao);
  ['rt-rpmn','rt-fn','rt-hz','rt-rpm'].forEach(id=>$(id).addEventListener('input',calcRot));

  $('limpar').onclick=()=>{
    if(estado.aba==='vazao'){ $('vz-cap').value=''; $('vz-fa').value=''; $('vz-fn').value='60'; $('vz-uni').value='m3h'; calcVazao(); }
    else{ ['rt-rpmn','rt-hz','rt-rpm'].forEach(id=>$(id).value=''); $('rt-fn').value='60'; calcRot(); }
  };

  // ---------- Capa ----------
  function abrir(a){ $('capa').hidden=true; $('app').hidden=false; mostrarAba(a); window.scrollTo(0,0); }
  document.querySelectorAll('[data-abrir]').forEach(b=>b.onclick=()=>abrir(b.dataset.abrir));
  $('voltar').onclick=()=>{ $('app').hidden=true; $('capa').hidden=false; window.scrollTo(0,0); };

  carregar();
  mostrarAba(estado.aba);
  modoRot(estado.modo);
  calcVazao();
})();
</script>
<script>
if('serviceWorker' in navigator){window.addEventListener('load',()=>{navigator.serviceWorker.register('sw.js').catch(()=>{});});}
</script>
